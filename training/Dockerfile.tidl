# TIDL derleme ortamı: edgeai-tidl-tools, SOC=am67a.
# 11_00_06_00 = TIDL 11_00_00_00, kart imajındaki C7x yazılımıyla aynı.
# 11_00_08_00 C7x yaması ister; yamasız kartta "TIVX_CMD_NODE_CREATE failed" verir.
# Sürüm kartın Processor SDK'sı ile aynı olmalı (SDK 11.00).
#   docker build -t gem-tidl:11_00_06_00 -f training/Dockerfile.tidl training
#   docker run --rm --shm-size=4g -v $PWD:/work -w /work/training gem-tidl:11_00_06_00 \
#       python3 compile_tidl.py --model ../models/waste_mnv2 --calib dataset/val
FROM ubuntu:22.04
ARG REL=11_00_06_00
ARG URL=https://software-dl.ti.com/jacinto7/esd/tidl-tools/${REL}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-pip wget ca-certificates libgl1 libglib2.0-0 graphviz \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir numpy==1.23.0 protobuf==3.20.3 onnx==1.14.0 pillow pyyaml \
    && pip3 install --no-cache-dir ${URL}/OSRT_TOOLS/X86_64_LINUX/UBUNTU_22_04/onnxruntime_tidl-1.15.0-cp310-cp310-linux_x86_64.whl
RUN mkdir -p /opt/tidl && cd /opt/tidl \
    && wget -q ${URL}/TIDL_TOOLS/AM67A/tidl_tools.tar.gz \
    && tar xzf tidl_tools.tar.gz && rm tidl_tools.tar.gz
ENV SOC=am67a TIDL_TOOLS_PATH=/opt/tidl/tidl_tools LD_LIBRARY_PATH=/opt/tidl/tidl_tools
